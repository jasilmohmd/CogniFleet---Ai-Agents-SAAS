{
  "module": "auth",
  "description": "Authentication via Better Auth (email/password + OAuth)",
  "configFile": "src/lib/auth.ts",
  "provider": "better-auth",
  "databaseAdapter": "drizzleAdapter (PostgreSQL)",
  "methods": {
    "emailPassword": true,
    "socialProviders": ["github", "google"]
  },
  "databaseTables": [
    "user",
    "session",
    "account",
    "verification"
  ],
  "trpcIntegration": {
    "contextFunction": "createTRPCContext (src/trpc/init.ts)",
    "sessionExtractor": "auth.api.getSession({ headers })",
    "protectedProcedure": "Validates session, attaches ctx.auth.user"
  },
  "views": [
    "SignInView",
    "SignUpView"
  ],
  "requiredEnvVars": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET"
  ],
  "sessionType": "Cookie-based (HttpOnly, Secure)"
}